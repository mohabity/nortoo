# ═══ nortoo Environment Variables ═══
# Copy to .env.local and fill in values
#
# ⚠️  ALL infrastructure MUST be in EU (Frankfurt) — Loi 09-08 Art.43
# ⚠️  NEVER deploy to US region

# ──────────────────────────────────────
# Database — Neon PostgreSQL (🇪🇺 Frankfurt)
# ──────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/nortoo?sslmode=require

# ──────────────────────────────────────
# Auth — Auth.js v5
# ──────────────────────────────────────
# AUTH_SECRET=                          # openssl rand -base64 32
# AUTH_URL=https://nortoo.io            # production URL

# ──────────────────────────────────────
# YouCan OAuth
# ──────────────────────────────────────
YOUCAN_CLIENT_ID=                       # YouCan app client ID
YOUCAN_CLIENT_SECRET=                   # YouCan app client secret
YOUCAN_REDIRECT_URI=https://nortoo.io/api/auth/youcan/callback  # OAuth callback URL

# ──────────────────────────────────────
# Upstash Redis — 🇪🇺 Frankfurt (Phase 2)
# ──────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────
# Stripe (Phase 2)
# ──────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────
# WhatsApp Cloud API (Phase 2)
# ──────────────────────────────────────
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ──────────────────────────────────────
# Security — CRITICAL
# ──────────────────────────────────────
PHONE_HASH_SALT=                        # Run: openssl rand -hex 32

# ──────────────────────────────────────
# Compliance — Loi 09-08
# ──────────────────────────────────────
CNDP_DECLARATION_REF=                   # Fill after CNDP filing
NETWORK_INTELLIGENCE_ENABLED=false      # DO NOT enable without CNDP authorization (Art. 12.1.f)
DATA_RETENTION_MONTHS=24

# ──────────────────────────────────────
# App
# ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://nortoo.io   # Production URL (used for webhook URLs)
