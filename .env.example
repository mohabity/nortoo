# ═══ nortoo Environment Variables ═══
# Copy to .env.local and fill in values
#
# ⚠️  ALL infrastructure MUST be in EU (Frankfurt) — Loi 09-08 Art.43
# ⚠️  NEVER deploy to US region

# ──────────────────────────────────────
# Database — Neon PostgreSQL (🇪🇺 Frankfurt)
# ──────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/nortoo?sslmode=require

# ──────────────────────────────────────
# Auth — Auth.js v5
# ──────────────────────────────────────
# AUTH_SECRET=                          # openssl rand -base64 32
# AUTH_URL=https://app.nortoo.ma        # production URL

# ──────────────────────────────────────
# YouCan OAuth
# ──────────────────────────────────────
YOUCAN_CLIENT_ID=                       # YouCan app client ID
YOUCAN_CLIENT_SECRET=                   # YouCan app client secret
YOUCAN_REDIRECT_URI=https://app.nortoo.ma/api/auth/youcan/callback  # OAuth callback URL

# ──────────────────────────────────────
# Upstash Redis — 🇪🇺 Frankfurt (Phase 2)
# ──────────────────────────────────────
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────
# Stripe (Phase 2)
# ──────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────
# WhatsApp Cloud API (Phase 2)
# ──────────────────────────────────────
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ──────────────────────────────────────
# Security — CRITICAL
# ──────────────────────────────────────
PHONE_HASH_SALT=                        # Run: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                   # Run: openssl rand -hex 32 (AES-256-GCM for token encryption)
CRON_SECRET=                            # Run: openssl rand -hex 32 (Vercel cron job auth)

# ──────────────────────────────────────
# Compliance — Loi 09-08
# ──────────────────────────────────────
CNDP_DECLARATION_REF=                   # Fill after CNDP filing
NETWORK_INTELLIGENCE_ENABLED=false      # DO NOT enable without CNDP authorization (Art. 12.1.f)
DATA_RETENTION_MONTHS=24

# ──────────────────────────────────────
# Sentry — Error Monitoring (🇪🇺 EU region ONLY — Loi 09-08)
# ──────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=               # Sentry DSN (EU data center — de.sentry.io)
# SENTRY_DSN=                           # Server-side DSN (same value)
# SENTRY_ORG=nortoo
# SENTRY_PROJECT=nortoo-web
# SENTRY_AUTH_TOKEN=                    # For source map uploads during build

# ──────────────────────────────────────
# Umami Analytics (🇪🇺 self-hosted, no cookies, CNDP-compliant)
# ──────────────────────────────────────
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=             # Umami website ID (UUID)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=             # Umami tracker script URL
# UMAMI_API_URL=                            # Umami REST API base URL (for cron aggregation)
# UMAMI_API_TOKEN=                          # Umami API auth token

# ──────────────────────────────────────
# App
# ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.nortoo.ma   # Production URL (used for webhook URLs)

# ──────────────────────────────────────
# Email — nortoo.ma
# ──────────────────────────────────────
SUPPORT_EMAIL=support@nortoo.ma
CONTACT_EMAIL=hello@nortoo.ma
NOREPLY_EMAIL=noreply@nortoo.ma
BILLING_EMAIL=billing@nortoo.ma
ADMIN_EMAIL=admin@nortoo.ma
